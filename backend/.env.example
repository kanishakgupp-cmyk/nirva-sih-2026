# Server environment
ENVIRONMENT=development

# Supabase public URL and server-side credentials.
# Never commit real values or expose service-role credentials to Flutter.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key

# Required before enabling protected endpoints.
SUPABASE_JWT_SECRET=replace-with-server-only-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
# Keep false for Supabase. Enable only for explicit local/test HS256 fixtures.
ENABLE_LOCAL_HS256_FALLBACK=false

# Optional direct PostgreSQL connection for future server-side data access.
DATABASE_URL=postgresql://user:password@host:5432/database

# Comma-separated Flutter development origins.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional regex for Codespaces forwarded Flutter web origins.
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+-8080\.(app\.github\.dev|githubpreview\.dev)$
