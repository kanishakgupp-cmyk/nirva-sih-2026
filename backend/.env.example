# Required for protected case routes. Never expose the service-role key to Flutter.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Optional local/test-only HS256 fixture support. Keep disabled for Supabase JWKS.
SUPABASE_JWT_SECRET=replace-with-local-test-only-secret
SUPABASE_JWT_AUDIENCE=authenticated
ENABLE_LOCAL_HS256_FALLBACK=false

# Optional settings. Defaults are suitable for local development.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+-8080\.(app\.github\.dev|githubpreview\.dev)$
